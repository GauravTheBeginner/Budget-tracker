# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection (all required — lib/database.py raises if any are missing)
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=budget_tracker

# Host/port of the database.
#  - Inside docker-compose: DB_ENDPOINT=postgres, DB_PORT=5432
#  - From your host machine: DB_ENDPOINT=localhost, DB_PORT=5436
DB_ENDPOINT=postgres
DB_PORT=5432
